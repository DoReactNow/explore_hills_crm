# =============================================================================
# Explore Hills CRM .gitignore
# Rule of thumb: if a command can regenerate it, or it is a secret, it is ignored.
# Folder patterns that could clash with source folders (for example src/shared/storage/)
# are anchored to the repository root with a leading slash.
# =============================================================================

# -----------------------------------------------------------------------------
# Libraries / dependencies (restored with `npm ci`)
# -----------------------------------------------------------------------------
node_modules/
.pnp
.pnp.*
.yarn/
.npm/

# -----------------------------------------------------------------------------
# Build output (regenerated with `npm run build`)
# -----------------------------------------------------------------------------
.next/
/out/
/build/
/dist/
.turbo/
*.tsbuildinfo
next-env.d.ts

# -----------------------------------------------------------------------------
# Generated code (regenerated with `npm run db:generate`)
# -----------------------------------------------------------------------------
/src/generated/
/generated/

# -----------------------------------------------------------------------------
# Test results and reports (regenerated by the test commands)
# -----------------------------------------------------------------------------
coverage/
.nyc_output/
test-results/
playwright-report/
blob-report/
playwright/.cache/
.vitest/
junit.xml

# -----------------------------------------------------------------------------
# Environment files: ignore every real one, keep ONLY the three examples
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
!.env.test.example
!.env.production.example

# -----------------------------------------------------------------------------
# PRIVATE SEEDS AND SECRETS
# The real (production) seed lives in prisma/private/ and is NEVER committed.
# The committed template is prisma/seed.example.ts (placeholders only).
# The test seed prisma/seed-test.ts is committed (fake data, test DB only).
# -----------------------------------------------------------------------------
prisma/private/

# Keys, certificates and credentials
*.pem
*.key
*.p12
*.pfx
*.crt
/secrets/
credentials.json
service-account*.json

# -----------------------------------------------------------------------------
# Database dumps and local backups
# -----------------------------------------------------------------------------
*.dump
*.sql.gz
*.bak
/backups/
/pgdata/

# -----------------------------------------------------------------------------
# Logs and runtime files
# -----------------------------------------------------------------------------
/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pid
*.pid

# -----------------------------------------------------------------------------
# Uploads and recordings handled at runtime (never commit customer data)
# storage/ is the folder used by the `local` storage driver (Decision 26),
# including storage/test used by the tests.
# -----------------------------------------------------------------------------
/storage/
/uploads/
/recordings/
/tmp/
/.tmp/

# -----------------------------------------------------------------------------
# OS files
# -----------------------------------------------------------------------------
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# -----------------------------------------------------------------------------
# Editors and IDEs (share only deliberately chosen settings)
# -----------------------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# -----------------------------------------------------------------------------
# Misc tooling caches
# -----------------------------------------------------------------------------
.eslintcache
.cache/
.parcel-cache/
.vercel/

# Personal Claude Code settings
.claude/settings.local.json
