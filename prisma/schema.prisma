// Explore Hills CRM: the Prisma schema. Target design: CONTEXT/database_schema.md.
// Conventions (prisma/CONVENTIONS.md): instants are @db.Timestamptz(3), business dates are
// @db.Date, IDs are UUID v7, tables are named <module>_<plural_noun>. Each phase adds only
// its own models. Constraints Prisma cannot express live as raw SQL in the migrations.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  // CommonJS, so the esbuild bundles (dist/worker.js, dist/sync-rbac.js) can include it.
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// identity module
// ---------------------------------------------------------------------------

enum IdentityUserStatus {
  INVITED
  ACTIVE
  DEACTIVATED
}

// Owner: identity. One row per code in src/shared/rbac/permissionRegistry.ts.
model IdentityPermission {
  id          String                   @id @default(uuid(7)) @db.Uuid
  code        String                   @unique // e.g. "leads:assign"
  label       String // human-readable name shown on the Roles & Permissions page
  description String
  module      String // owning module, for grouping on the Roles & Permissions page
  isReserved  Boolean                  @default(false) // never grantable to any role (Decision 23)
  createdAt   DateTime                 @default(now()) @db.Timestamptz(3)
  roles       IdentityRolePermission[]

  @@map("identity_permissions")
}

// Owner: identity. SUPER_ADMIN, ADMIN, MANAGER, AGENT, or a custom role.
model IdentityRole {
  id             String                   @id @default(uuid(7)) @db.Uuid
  code           String                   @unique
  name           String
  description    String?
  isSystem       Boolean                  @default(false) // system roles cannot be deleted
  bypassesAccess Boolean                  @default(false) // true only for SUPER_ADMIN; at most one row
  createdAt      DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                 @updatedAt @db.Timestamptz(3)
  permissions    IdentityRolePermission[] // SUPER_ADMIN holds none: it bypasses every check
  users          IdentityUser[]

  @@map("identity_roles")
}

// Owner: identity. Grants of permissions to roles.
model IdentityRolePermission {
  roleId       String             @db.Uuid
  permissionId String             @db.Uuid
  role         IdentityRole       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   IdentityPermission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("identity_role_permissions")
}

// Owner: identity. Staff accounts. Never hard-deleted: deactivated instead (status DEACTIVATED).
// managerId is the one reporting line; team membership is many-to-many (Decision 55).
model IdentityUser {
  id                             String                          @id @default(uuid(7)) @db.Uuid
  email                          String                          @unique // stored lowercase; lower(email) is also unique (raw SQL)
  name                           String
  phoneE164                      String? // E.164, checked in SQL
  passwordHash                   String // argon2id; never returned by any API or written to any log
  status                         IdentityUserStatus              @default(INVITED)
  roleId                         String                          @db.Uuid
  role                           IdentityRole                    @relation(fields: [roleId], references: [id], onDelete: Restrict) // a role still held by users cannot be deleted
  failedLoginCount               Int                             @default(0)
  lockedUntil                    DateTime?                       @db.Timestamptz(3)
  lastLoginAt                    DateTime?                       @db.Timestamptz(3)
  createdAt                      DateTime                        @default(now()) @db.Timestamptz(3)
  updatedAt                      DateTime                        @updatedAt @db.Timestamptz(3)
  deactivatedAt                  DateTime?                       @db.Timestamptz(3)
  managerId                      String?                         @db.Uuid
  manager                        IdentityUser?                   @relation("UserManager", fields: [managerId], references: [id], onDelete: Restrict)
  reports                        IdentityUser[]                  @relation("UserManager")
  managedTeams                   IdentityTeam[]                  @relation("TeamManager")
  teamMemberships                IdentityTeamMember[]
  sessions                       IdentitySession[]
  auditEvents                    AuditEvent[] // back-relation from the audit module
  ownedLeads                     LeadsLead[]
  notes                          LeadsNote[]
  consentsRecorded               LeadsConsentRecord[]
  tasks                          LeadsTask[]
  timelineEntries                LeadsTimelineEntry[]
  updatedSettings                SystemSetting[]
  sentMessages                   MessagingMessage[]
  assignmentSetting              AssignmentAgentSetting?
  createdRules                   AssignmentRule[]
  requestedBatches               AssignmentBatch[]
  assignmentsFrom                AssignmentRecord[]              @relation("AssignmentFrom")
  assignmentsTo                  AssignmentRecord[]              @relation("AssignmentTo")
  claimedPoolEntries             AssignmentPoolEntry[]
  poolEligibility                AssignmentPoolEligibility[]
  telephonyAgentEndpoints        TelephonyAgentEndpoint[]
  telephonyCalls                 TelephonyCall[]
  notificationsNotifications     NotificationsNotification[]
  notificationsPreferences       NotificationsPreference[]
  notificationsPushSubscriptions NotificationsPushSubscription[]

  @@index([roleId])
  @@index([status])
  @@index([managerId])
  @@map("identity_users")
}

// Owner: identity. A team; a person may belong to several (Decision 55). The name is unique in any
// case (raw SQL). A team with members cannot be deleted: its members must move first.
model IdentityTeam {
  id            String               @id @default(uuid(7)) @db.Uuid
  name          String               @unique
  managerUserId String?              @db.Uuid
  manager       IdentityUser?        @relation("TeamManager", fields: [managerUserId], references: [id], onDelete: Restrict)
  members       IdentityTeamMember[]
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)

  @@index([managerUserId])
  @@map("identity_teams")
}

// Owner: identity. Who belongs to which team.
model IdentityTeamMember {
  teamId    String       @db.Uuid
  team      IdentityTeam @relation(fields: [teamId], references: [id], onDelete: Restrict)
  userId    String       @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@id([teamId, userId])
  @@index([userId])
  @@map("identity_team_members")
}

// Owner: identity. A signed-in browser (Decision 46): 12 h sliding expiry, capped at 7 days.
// Only the SHA-256 hash of the session token is stored, never the token.
model IdentitySession {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @db.Uuid
  user       IdentityUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String       @unique
  expiresAt  DateTime     @db.Timestamptz(3)
  lastSeenAt DateTime     @db.Timestamptz(3)
  revokedAt  DateTime?    @db.Timestamptz(3)
  ip         String?
  userAgent  String?
  createdAt  DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@index([expiresAt])
  @@map("identity_sessions")
}

// Owner: identity. Sign-in attempts per IP address in the current window (Decision 46).
// The key is a hash of the IP address, never the address itself.
model IdentityLoginThrottle {
  key         String   @id
  windowStart DateTime @db.Timestamptz(3)
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  @@index([windowStart])
  @@map("identity_login_throttle")
}

// ---------------------------------------------------------------------------
// audit module
// ---------------------------------------------------------------------------

// Owner: audit. Append-only (a trigger refuses UPDATE and DELETE). Metadata holds IDs, never
// names, emails or phone numbers. entityType/entityId are polymorphic, so they have no foreign key.
model AuditEvent {
  id            String        @id @default(uuid(7)) @db.Uuid
  occurredAt    DateTime      @db.Timestamptz(3)
  actorUserId   String?       @db.Uuid // → identity.identity_users (null = system: job or webhook)
  actor         IdentityUser? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  actorRoleCode String? // role at the time, e.g. SUPER_ADMIN
  action        String // from AUDIT_ACTIONS, e.g. "user.created"
  entityType    String
  entityId      String
  summary       String
  metadata      Json          @default("{}")
  requestId     String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([action, occurredAt])
  @@map("audit_events")
}

// ---------------------------------------------------------------------------
// system module
// ---------------------------------------------------------------------------

// Owner: system. Files waiting to be deleted from FileStorage. A row is written in the same transaction
// as the change that makes the file unwanted, and goes only once the file has gone (P10-ERASE-02).
model SystemFileDeletion {
  id         String   @id @default(uuid(7)) @db.Uuid
  storageKey String   @unique
  reason     String
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt])
  @@map("system_file_deletions")
}

// Owner: system. Written by the worker every few seconds; read by diagnostics.
model SystemWorkerHeartbeat {
  workerId   String   @id // hostname + process id
  version    String // app version / git SHA
  startedAt  DateTime @db.Timestamptz(3)
  lastBeatAt DateTime @db.Timestamptz(3)

  @@map("system_worker_heartbeats")
}

// ---------------------------------------------------------------------------
// leads module
// ---------------------------------------------------------------------------

enum LeadsSource {
  WHATSAPP
  PHONE
  MANUAL
  WEBSITE
  AD
  IMPORT
}

enum LeadsStageKind {
  OPEN
  WON
  LOST
}

enum LeadsOptInStatus {
  UNKNOWN
  OPTED_IN
  OPTED_OUT
}

enum LeadsConsentPurpose {
  WHATSAPP
  CALL_RECORDING
}

enum LeadsConsentStatus {
  GRANTED
  WITHDRAWN
}

enum LeadsTimelineKind {
  LEAD_CREATED
  STAGE_CHANGED
  ASSIGNED
  NOTE
  MESSAGE
  CALL
  TASK
}

// Owner: leads. The stage list is configuration, seeded with the travel default.
model LeadsPipelineStage {
  id        String         @id @default(uuid(7)) @db.Uuid
  code      String         @unique
  name      String
  position  Int
  kind      LeadsStageKind @default(OPEN)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)
  leads     LeadsLead[]

  @@index([position])
  @@map("leads_pipeline_stages")
}

// Owner: leads. Personal data. One row per phone number: the duplicate-merge key.
model LeadsContact {
  id                String                  @id @default(uuid(7)) @db.Uuid
  phoneE164         String                  @unique
  name              String?
  email             String?
  optInStatus       LeadsOptInStatus        @default(UNKNOWN)
  optInAt           DateTime?               @db.Timestamptz(3)
  optInSource       String?
  anonymisedAt      DateTime?               @db.Timestamptz(3)
  // Set while the customer has withdrawn consent to call recording.
  recordingOptOutAt DateTime?               @db.Timestamptz(3)
  // Set while a legal or open-case hold applies: no retention deletion and no erasure (Decision 66).
  legalHoldAt       DateTime?               @db.Timestamptz(3)
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?               @db.Timestamptz(3)
  leads             LeadsLead[]
  conversations     MessagingConversation[]
  consents          LeadsConsentRecord[]

  @@map("leads_contacts")
}

// Owner: leads. Who consented or withdrew, when and how. Append-only (a trigger refuses changes), and it
// holds no personal data of its own, so it outlives an erasure as the proof (Decision 66).
model LeadsConsentRecord {
  id               String              @id @default(uuid(7)) @db.Uuid
  contactId        String              @db.Uuid
  contact          LeadsContact        @relation(fields: [contactId], references: [id], onDelete: Restrict)
  purpose          LeadsConsentPurpose
  status           LeadsConsentStatus
  source           String
  recordedByUserId String?             @db.Uuid // null = the customer's own action or a job
  recordedBy       IdentityUser?       @relation(fields: [recordedByUserId], references: [id], onDelete: Restrict)
  occurredAt       DateTime            @db.Timestamptz(3)
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  @@index([contactId, occurredAt])
  @@map("leads_consent_records")
}

// Owner: leads. Unassigned means ownerUserId is null; it is never a stage.
model LeadsLead {
  id                String                  @id @default(uuid(7)) @db.Uuid
  contactId         String                  @db.Uuid
  contact           LeadsContact            @relation(fields: [contactId], references: [id], onDelete: Restrict)
  source            LeadsSource             @default(WHATSAPP)
  sourceDetail      String?
  stageId           String                  @db.Uuid
  stage             LeadsPipelineStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  ownerUserId       String?                 @db.Uuid
  owner             IdentityUser?           @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  assignedAt        DateTime?               @db.Timestamptz(3)
  priorityScore     Int                     @default(0)
  destination       String?
  travelStartDate   DateTime?               @db.Date
  travelEndDate     DateTime?               @db.Date
  travellerCount    Int?
  budgetAmount      Decimal?                @db.Decimal(12, 2)
  customFields      Json                    @default("{}")
  firstResponseAt   DateTime?               @db.Timestamptz(3)
  lastActivityAt    DateTime?               @db.Timestamptz(3)
  nextFollowUpDate  DateTime?               @db.Date
  closedAt          DateTime?               @db.Timestamptz(3)
  lostReason        String?
  createdAt         DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime?               @db.Timestamptz(3)
  mergedIntoLeadId  String?                 @db.Uuid
  conversations     MessagingConversation[]
  notes             LeadsNote[]
  tasks             LeadsTask[]
  timeline          LeadsTimelineEntry[]
  assignmentRecords AssignmentRecord[]
  poolEntries       AssignmentPoolEntry[]
  escalation        AssignmentEscalation?
  telephonyCalls    TelephonyCall[]

  @@index([ownerUserId, stageId])
  @@index([stageId])
  @@index([ownerUserId, createdAt])
  @@index([nextFollowUpDate])
  @@index([createdAt])
  @@index([contactId])
  @@index([deletedAt])
  @@map("leads_leads")
}

// Owner: leads. Notes cannot be edited or deleted (Decision 57).
model LeadsNote {
  id           String       @id @default(uuid(7)) @db.Uuid
  leadId       String       @db.Uuid
  lead         LeadsLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  authorUserId String       @db.Uuid
  author       IdentityUser @relation(fields: [authorUserId], references: [id], onDelete: Restrict)
  body         String
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
  @@index([authorUserId])
  @@map("leads_notes")
}

// Owner: leads. A follow-up. dueDate is a business date.
model LeadsTask {
  id             String       @id @default(uuid(7)) @db.Uuid
  leadId         String       @db.Uuid
  lead           LeadsLead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assigneeUserId String       @db.Uuid
  assignee       IdentityUser @relation(fields: [assigneeUserId], references: [id], onDelete: Restrict)
  title          String
  dueDate        DateTime     @db.Date
  completedAt    DateTime?    @db.Timestamptz(3)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  @@index([assigneeUserId, dueDate])
  @@index([leadId])
  @@map("leads_tasks")
}

// Owner: leads. One row per event, so the lead page loads one timeline.
model LeadsTimelineEntry {
  id          String            @id @default(uuid(7)) @db.Uuid
  leadId      String            @db.Uuid
  lead        LeadsLead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  kind        LeadsTimelineKind
  summary     String
  refType     String?
  refId       String?
  actorUserId String?           @db.Uuid
  actor       IdentityUser?     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  occurredAt  DateTime          @db.Timestamptz(3)
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)

  @@unique([refType, refId, kind])
  @@index([leadId, occurredAt])
  @@map("leads_timeline_entries")
}

// Owner: system. Validated against the registry in system.settings.ts.
model SystemSetting {
  key             String        @id
  value           Json
  updatedByUserId String?       @db.Uuid
  updatedBy       IdentityUser? @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)
  updatedAt       DateTime      @updatedAt @db.Timestamptz(3)

  @@map("system_settings")
}

// ---------------------------------------------------------------------------
// messaging module
// ---------------------------------------------------------------------------

enum MessagingDirection {
  INBOUND
  OUTBOUND
}

enum MessagingMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  VIDEO
  TEMPLATE
  INTERACTIVE
  UNSUPPORTED
}

enum MessagingMessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

enum MessagingTemplateCategory {
  UTILITY
  MARKETING
  AUTHENTICATION
}

// Owner: messaging. Personal data. Who may see it follows its lead (Decision 58).
model MessagingConversation {
  id                    String             @id @default(uuid(7)) @db.Uuid
  businessPhoneNumberId String
  waId                  String
  contactId             String             @db.Uuid
  contact               LeadsContact       @relation(fields: [contactId], references: [id], onDelete: Restrict)
  leadId                String?            @db.Uuid
  lead                  LeadsLead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  lastInboundAt         DateTime?          @db.Timestamptz(3)
  lastMessageAt         DateTime?          @db.Timestamptz(3)
  unreadCount           Int                @default(0)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)
  messages              MessagingMessage[]

  @@unique([businessPhoneNumberId, waId])
  @@index([lastMessageAt])
  @@index([leadId])
  @@index([contactId])
  @@map("messaging_conversations")
}

// Owner: messaging. Personal data. File bytes live in FileStorage, never here.
model MessagingMessage {
  id                String                 @id @default(uuid(7)) @db.Uuid
  conversationId    String                 @db.Uuid
  conversation      MessagingConversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  direction         MessagingDirection
  type              MessagingMessageType
  waMessageId       String?                @unique
  clientRef         String?                @unique
  replyToWaId       String?
  body              String?
  mediaRef          String?
  mediaStatus       String? // PENDING, STORED or FAILED
  mediaMimeType     String?
  mediaFilename     String?
  templateName      String?
  templateId        String?                @db.Uuid
  templateVariables Json?
  status            MessagingMessageStatus
  failureCode       String?
  sentByUserId      String?                @db.Uuid
  sentBy            IdentityUser?          @relation(fields: [sentByUserId], references: [id], onDelete: Restrict)
  occurredAt        DateTime               @db.Timestamptz(3)
  deliveredAt       DateTime?              @db.Timestamptz(3)
  readAt            DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)

  @@index([conversationId, occurredAt])
  @@index([sentByUserId])
  @@map("messaging_messages")
}

// Owner: messaging. status is the provider's approval state, such as APPROVED or REJECTED.
model MessagingTemplate {
  id             String                    @id @default(uuid(7)) @db.Uuid
  name           String
  language       String
  category       MessagingTemplateCategory
  status         String
  body           String
  variables      Json                      @default("[]")
  providerRef    String?
  rejectedReason String?
  createdAt      DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime                  @updatedAt @db.Timestamptz(3)

  @@unique([name, language])
  @@map("messaging_templates")
}

// Owner: messaging. Webhook deliveries, one row per event; processing runs as a job (Decision 27).
model MessagingWebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  eventKey    String    @unique
  kind        String
  waMessageId String?
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  error       String?

  @@index([receivedAt])
  @@index([waMessageId])
  @@map("messaging_webhook_events")
}

// ---------------------------------------------------------------------------
// assignment module
// ---------------------------------------------------------------------------

enum AssignmentMode {
  MANUAL
  ROUND_ROBIN
  LEAST_LOADED
  PRIORITY
  RANDOM
  BLAST
}

enum AssignmentBatchStatus {
  COMMITTED
  FAILED
}

enum AssignmentPoolStatus {
  OPEN
  CLAIMED
  EXPIRED
  CANCELLED
}

// Owner: assignment. No row means the defaults: available, no shifts, the default cap.
model AssignmentAgentSetting {
  id            String            @id @default(uuid(7)) @db.Uuid
  userId        String            @unique @db.Uuid
  user          IdentityUser      @relation(fields: [userId], references: [id], onDelete: Restrict)
  isAvailable   Boolean           @default(true)
  openLeadCap   Int? // null = the system default; 0 = no leads
  priorityTier  Int               @default(0) // higher = served first
  languages     String[]
  destinations  String[]
  leaveFromDate DateTime?         @db.Date
  leaveToDate   DateTime?         @db.Date
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  shifts        AssignmentShift[]

  @@map("assignment_agent_settings")
}

// Owner: assignment. endMinute <= startMinute means it crosses midnight, counted to weekday.
model AssignmentShift {
  id          String                 @id @default(uuid(7)) @db.Uuid
  settingId   String                 @db.Uuid
  setting     AssignmentAgentSetting @relation(fields: [settingId], references: [id], onDelete: Cascade)
  weekday     Int // 0 = Sunday ... 6 = Saturday, in the business timezone
  startMinute Int
  endMinute   Int

  @@unique([settingId, weekday, startMinute])
  @@map("assignment_shifts")
}

// Owner: assignment. At most one active auto-assign rule (partial unique index, raw SQL).
model AssignmentRule {
  id                String         @id @default(uuid(7)) @db.Uuid
  name              String         @unique
  mode              AssignmentMode
  config            Json           @default("{}")
  isAutoAssign      Boolean        @default(false)
  isActive          Boolean        @default(true)
  autoAssignedUntil DateTime?      @db.Timestamptz(3) // leads created before this have had their turn
  createdByUserId   String         @db.Uuid
  createdBy         IdentityUser   @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  @@map("assignment_rules")
}

// Owner: assignment. One confirmation = one batch. No requester means auto-assign.
model AssignmentBatch {
  id                String                @id @default(uuid(7)) @db.Uuid
  idempotencyKey    String                @unique
  mode              AssignmentMode
  requestedByUserId String?               @db.Uuid
  requestedBy       IdentityUser?         @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  status            AssignmentBatchStatus
  leadCount         Int
  config            Json                  @default("{}")
  createdAt         DateTime              @default(now()) @db.Timestamptz(3)
  records           AssignmentRecord[]

  @@index([createdAt])
  @@map("assignment_batches")
}

// Owner: assignment. The history of who owned a lead, with its response timer.
model AssignmentRecord {
  id            String           @id @default(uuid(7)) @db.Uuid
  batchId       String?          @db.Uuid
  batch         AssignmentBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  leadId        String           @db.Uuid
  lead          LeadsLead        @relation(fields: [leadId], references: [id], onDelete: Restrict)
  fromUserId    String?          @db.Uuid
  fromUser      IdentityUser?    @relation("AssignmentFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUserId      String           @db.Uuid
  toUser        IdentityUser     @relation("AssignmentTo", fields: [toUserId], references: [id], onDelete: Restrict)
  actorUserId   String?          @db.Uuid // no FK target needed: audit holds the actor's history
  mode          AssignmentMode
  reason        String?
  responseDueAt DateTime?        @db.Timestamptz(3) // null = no timer running
  respondedAt   DateTime?        @db.Timestamptz(3)
  timedOutAt    DateTime?        @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @db.Timestamptz(3)

  @@index([leadId, createdAt])
  @@index([toUserId, createdAt])
  @@index([responseDueAt])
  @@map("assignment_records")
}

// Owner: assignment. A lead that kept timing out and is waiting for a manager.
model AssignmentEscalation {
  leadId      String    @id @db.Uuid
  lead        LeadsLead @relation(fields: [leadId], references: [id], onDelete: Restrict)
  timeouts    Int
  escalatedAt DateTime  @db.Timestamptz(3)

  @@map("assignment_escalations")
}

// Owner: assignment. A lead offered to several agents. One OPEN entry per lead (raw SQL index).
model AssignmentPoolEntry {
  id              String                      @id @default(uuid(7)) @db.Uuid
  leadId          String                      @db.Uuid
  lead            LeadsLead                   @relation(fields: [leadId], references: [id], onDelete: Restrict)
  batchId         String?                     @db.Uuid
  status          AssignmentPoolStatus        @default(OPEN)
  claimedByUserId String?                     @db.Uuid
  claimedBy       IdentityUser?               @relation(fields: [claimedByUserId], references: [id], onDelete: Restrict)
  claimedAt       DateTime?                   @db.Timestamptz(3)
  expiresAt       DateTime                    @db.Timestamptz(3)
  createdAt       DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime                    @updatedAt @db.Timestamptz(3)
  eligibleUsers   AssignmentPoolEligibility[]

  @@index([status, expiresAt])
  @@index([leadId])
  @@map("assignment_pool_entries")
}

// Owner: assignment. Who an open pool entry was offered to.
model AssignmentPoolEligibility {
  poolEntryId String              @db.Uuid
  poolEntry   AssignmentPoolEntry @relation(fields: [poolEntryId], references: [id], onDelete: Cascade)
  userId      String              @db.Uuid
  user        IdentityUser        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([poolEntryId, userId])
  @@index([userId])
  @@map("assignment_pool_eligibility")
}

// ---------------------------------------------------------------------------
// telephony module
// ---------------------------------------------------------------------------

enum TelephonyDirection {
  OUTBOUND
  INBOUND
}

enum TelephonyChannel {
  BROWSER
  PHONE
}

enum TelephonyCallStatus {
  INITIATED
  RINGING_AGENT
  RINGING_CUSTOMER
  ANSWERED
  COMPLETED
  NO_ANSWER
  BUSY
  FAILED
  CANCELLED
}

enum TelephonyRecordingStatus {
  PENDING
  DOWNLOADING
  STORED
  FAILED
  DELETED
}

// Owner: telephony. One per agent and provider. Logins are encrypted; token-based providers leave them
// empty. lastSeenAt says the softphone is connected, which inbound routing needs.
model TelephonyAgentEndpoint {
  id              String       @id @default(uuid(7)) @db.Uuid
  providerKey     String
  userId          String       @db.Uuid
  user            IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  loginEncrypted  String?
  secretEncrypted String?
  isActive        Boolean      @default(true)
  lastSeenAt      DateTime?    @db.Timestamptz(3)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  @@unique([providerKey, userId])
  @@map("telephony_agent_endpoints")
}

// Owner: telephony. Personal data (phone number).
model TelephonyCall {
  id                String              @id @default(uuid(7)) @db.Uuid
  providerKey       String
  providerCallId    String?
  callRef           String              @unique
  direction         TelephonyDirection  @default(OUTBOUND)
  channel           TelephonyChannel    @default(BROWSER)
  status            TelephonyCallStatus @default(INITIATED)
  leadId            String?             @db.Uuid
  lead              LeadsLead?          @relation(fields: [leadId], references: [id], onDelete: Restrict)
  agentUserId       String?             @db.Uuid
  agent             IdentityUser?       @relation(fields: [agentUserId], references: [id], onDelete: Restrict)
  customerPhoneE164 String
  routingNote       String?
  startedAt         DateTime            @db.Timestamptz(3)
  answeredAt        DateTime?           @db.Timestamptz(3)
  endedAt           DateTime?           @db.Timestamptz(3)
  durationSeconds   Int?
  billableSeconds   Int?
  outcomeCode       String?
  outcomeNotes      String?
  createdAt         DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @db.Timestamptz(3)
  recording         TelephonyRecording?

  @@unique([providerKey, providerCallId])
  @@index([leadId, startedAt])
  @@index([agentUserId, startedAt])
  @@index([customerPhoneE164])
  @@index([status])
  @@map("telephony_calls")
}

// Owner: telephony. Metadata only: the audio lives in FileStorage under storageKey.
model TelephonyRecording {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  callId               String                   @unique @db.Uuid
  call                 TelephonyCall            @relation(fields: [callId], references: [id], onDelete: Cascade)
  status               TelephonyRecordingStatus @default(PENDING)
  providerRecordingRef String?
  storageKey           String?                  @unique
  contentType          String?
  sizeBytes            Int?
  durationSeconds      Int?
  checksumSha256       String?
  attempts             Int                      @default(0)
  lastError            String?
  readyAt              DateTime?                @db.Timestamptz(3)
  storedAt             DateTime?                @db.Timestamptz(3)
  expiresAt            DateTime?                @db.Timestamptz(3)
  deletedAt            DateTime?                @db.Timestamptz(3)
  createdAt            DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime                 @updatedAt @db.Timestamptz(3)

  @@index([status])
  @@index([expiresAt])
  @@map("telephony_recordings")
}

// Owner: telephony. The raw webhook log; a job does the processing.
model TelephonyWebhookEvent {
  id          String    @id @default(uuid(7)) @db.Uuid
  providerKey String
  eventKey    String
  payload     Json
  receivedAt  DateTime  @default(now()) @db.Timestamptz(3)
  processedAt DateTime? @db.Timestamptz(3)
  error       String?

  @@unique([providerKey, eventKey])
  @@index([receivedAt])
  @@map("telephony_webhook_events")
}

// ---------------------------------------------------------------------------
// notifications module
// ---------------------------------------------------------------------------

// Owner: notifications. One row can stand for several like events (groupCount). dedupeKeys holds every
// event it covers, so the same event delivered twice notifies once.
model NotificationsNotification {
  id         String       @id @default(uuid(7)) @db.Uuid
  userId     String       @db.Uuid
  user       IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  kind       String
  title      String
  body       String
  link       String?
  groupCount Int          @default(1)
  dedupeKeys String[]
  readAt     DateTime?    @db.Timestamptz(3)
  createdAt  DateTime     @db.Timestamptz(3)
  updatedAt  DateTime     @updatedAt @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@map("notifications_notifications")
}

// Owner: notifications. No row means everything is on.
model NotificationsPreference {
  userId    String       @id @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  inApp     Boolean      @default(true)
  email     Boolean      @default(true)
  push      Boolean      @default(true)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@map("notifications_preferences")
}

// Owner: notifications. A browser that accepted push notifications.
model NotificationsPushSubscription {
  id        String       @id @default(uuid(7)) @db.Uuid
  userId    String       @db.Uuid
  user      IdentityUser @relation(fields: [userId], references: [id], onDelete: Restrict)
  endpoint  String       @unique
  p256dh    String
  auth      String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)

  @@index([userId])
  @@map("notifications_push_subscriptions")
}
