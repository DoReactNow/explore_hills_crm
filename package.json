{
  "name": "explore-hills-crm",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/run-next.mjs dev .env",
    "build": "next build",
    "build:worker": "esbuild src/worker/index.ts --bundle --platform=node --packages=external --outfile=dist/worker.js",
    "build:tools": "esbuild src/modules/identity/rbac/syncRbac.cli.ts --bundle --platform=node --packages=external --outfile=dist/sync-rbac.js && esbuild src/modules/identity/resetSuperAdminPassword.cli.ts --bundle --platform=node --packages=external --outfile=dist/reset-super-admin-password.js",
    "worker": "dotenv run -q --override -f .env -- tsx watch src/worker/index.ts",
    "worker:start": "node dist/worker.js",
    "start": "node scripts/run-next.mjs start .env",
    "start:test": "node scripts/run-next.mjs start .env.test",
    "lint": "npm run lint:code && npm run lint:arch && npm run format:check",
    "lint:code": "eslint .",
    "lint:arch": "depcruise src --config .dependency-cruiser.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "vitest run --project unit --project unit-dom && npm run test:unit:tz",
    "test:unit:tz": "cross-env TZ=UTC vitest run --project unit src/shared/time && cross-env TZ=Asia/Kolkata vitest run --project unit src/shared/time && cross-env TZ=America/Los_Angeles vitest run --project unit src/shared/time && cross-env TZ=Pacific/Kiritimati vitest run --project unit src/shared/time",
    "test:integration": "npm run db:test:prepare && vitest run --project integration",
    "test:e2e": "npm run db:test:prepare && playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:watch": "vitest --project unit --project unit-dom",
    "ci:quality": "npm run lint && npm run typecheck && npm run build && npm run build:worker && npm run test:unit && npm run test:integration && npm run test:e2e",
    "guard:files": "node scripts/check-forbidden-files.mjs",
    "db:generate": "prisma generate",
    "db:migrate:dev": "dotenv run -q --override -f .env -- prisma migrate dev",
    "db:migrate:deploy": "dotenv run -q --override -f .env -- prisma migrate deploy",
    "db:migrate:check": "npm run db:test:migrate && dotenv run -q --override -f .env.test -- prisma migrate diff --from-config-datasource --to-schema prisma/schema.prisma --exit-code",
    "db:test:migrate": "dotenv run -q --override -f .env.test -- prisma migrate deploy",
    "db:test:prepare": "tsx scripts/prepare-test-db.ts",
    "db:sync-rbac": "dotenv run -q --override -f .env -- tsx src/modules/identity/rbac/syncRbac.cli.ts",
    "db:seed": "dotenv run -q --override -f .env -- tsx scripts/run-real-seed.ts",
    "db:seed:test": "dotenv run -q --override -f .env.test -- tsx prisma/seed-test.ts",
    "db:reset:dev": "tsx scripts/reset-db.ts .env",
    "db:reset:test": "tsx scripts/reset-db.ts .env.test",
    "docker:db:up": "docker compose -f docker/docker-compose.local.yml up -d db",
    "docker:db:down": "docker compose -f docker/docker-compose.local.yml down",
    "docker:db:create:dev": "docker exec explorehills_local_db psql -U explorehills_user -d postgres -c \"CREATE DATABASE explorehills_dev OWNER explorehills_user;\"",
    "docker:db:create:test": "docker exec explorehills_local_db psql -U explorehills_user -d postgres -c \"CREATE DATABASE explorehills_test OWNER explorehills_user;\"",
    "docker:local:up": "docker compose -f docker/docker-compose.local.yml --profile app up -d --build",
    "docker:local:logs": "docker compose -f docker/docker-compose.local.yml --profile app logs -f app worker",
    "docker:local:down": "docker compose -f docker/docker-compose.local.yml --profile app down",
    "docker:prod:build": "docker compose --env-file .env.production -f docker/docker-compose.prod.yml build",
    "docker:prod:up": "docker compose --env-file .env.production -f docker/docker-compose.prod.yml up -d",
    "user:reset-super-admin-password": "dotenv run -q --override -f .env -- tsx src/modules/identity/resetSuperAdminPassword.cli.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "libphonenumber-js": "1.13.15",
    "luxon": "3.7.2",
    "next": "16.4.3",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/luxon": "3.7.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "cross-env": "10.1.0",
    "dependency-cruiser": "18.7.0",
    "dotenv": "18.0.9",
    "dotenv-cli": "11.1.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
