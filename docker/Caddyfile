# HTTPS in front of the app (Decision 69). Caddy gets and renews the certificate and sends http to https.
{
	email {$ACME_EMAIL}
	https_port {$HTTPS_PORT:443}
	http_port {$HTTP_PORT:80}
}

{$APP_DOMAIN} {
	# The largest file an agent can send, plus room for the form around it.
	request_body {
		max_size 30MB
	}
	@compressible not path /api/events/stream
	encode @compressible gzip
	reverse_proxy app:47213 {
		# Live updates must arrive at once, not when a buffer fills.
		flush_interval -1
	}
	header -Server
}
